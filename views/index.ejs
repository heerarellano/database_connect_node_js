<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>DataTables Switch</title>

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- jQuery -->
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

  <!-- DataTables -->
  <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
  <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
</head>

<body>

<div class="container-fluid py-3">

  <div class="row mb-3">
    <div class="col-12">
      <h2 class="text-center text-md-start">
        Data Tables
      </h2>
    </div>
  </div>

  <div class="row g-2 mb-4">

    <div class="col-12 col-md-auto">
      <button id="btnAuthors" class="btn btn-primary w-100">
        Authors
      </button>
    </div>

    <div class="col-12 col-md-auto">
      <button id="btnBooks" class="btn btn-primary w-100">
        Books
      </button>
    </div>

    <div class="col-12 col-md-auto">
      <button
        class="btn btn-success w-100"
        onclick="window.location.href='/authors/new'">
        New Author Render
      </button>
    </div>

    <div class="col-12 col-md-auto">
      <button
        id="btnNewAuthor"
        class="btn btn-success w-100">
        New Author Ajax
      </button>
    </div>

    <div class="col-12 col-md-auto">
      <button
        id="btnOpenAuthorModal"
        class="btn btn-success w-100">
        New Author Modal
      </button>
    </div>

  </div>

  <!-- MODAL CREATE AUTHOR -->

  <div
    class="modal fade"
    id="authorModal"
    tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

      <div class="modal-content">

        <div class="modal-header">

          <h5 class="modal-title">
            New Author
          </h5>

          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="modal">
          </button>

        </div>

        <div class="modal-body">

          <form id="authorFormModal">

            <input
              type="text"
              id="authorName"
              class="form-control mb-2"
              placeholder="Name">

            <input
              type="number"
              id="authorAge"
              class="form-control mb-2"
              placeholder="Age">

          </form>

        </div>

        <div class="modal-footer">

          <button
            type="button"
            class="btn btn-secondary"
            data-bs-dismiss="modal">
            Close
          </button>

          <button
            type="button"
            id="btnSaveAuthor"
            class="btn btn-success">
            Save
          </button>

        </div>

      </div>

    </div>

  </div>

  <!-- TABLE -->

  <div class="table-responsive">

    <table
      id="mainTable"
      class="display"
      style="width:100%">

      <thead>
        <tr id="tableHead"></tr>
      </thead>

    </table>

  </div>

  <!-- VIEW MODAL -->

  <div
    class="modal fade"
    id="viewModal"
    tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

      <div class="modal-content">

        <div class="modal-header">

          <h5 class="modal-title">
            Inf
          </h5>

          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="modal">
          </button>

        </div>

        <div class="modal-body">

          <form>

            <input
              type="text"
              id="viewId"
              class="form-control mb-2"
              readonly>

            <input
              type="text"
              id="viewName"
              class="form-control mb-2">

            <input
              type="text"
              id="viewExtra"
              class="form-control mb-2">

          </form>

        </div>

        <div class="modal-footer">

          <button
            type="button"
            class="btn btn-secondary"
            data-bs-dismiss="modal">
            Close
          </button>

          <button
            type="button"
            id="btnUpdate"
            class="btn btn-success">
            Update
          </button>

        </div>

      </div>

    </div>

  </div>

</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<!-- Main JS -->
<script src="/js/main.js"></script>

</body>
</html>